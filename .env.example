VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# IMPORTANTE: este proyecto Supabase debe ser DISTINTO al de nahueltrek-site.
# fondos.0km.app y nahueltrek-site deben permanecer independientes
# (ver ARCHITECTURE_FONDOS_0KM.md, seccion 3).
#
# NOTA (2026-08-30): la arquitectura de backend pivoteó de Supabase a
# Laravel + MySQL (ver ARCHITECTURE_FONDOS_0KM.md). Las variables de
# arriba quedan sin uso una vez completada la Fase D (api.js conectado
# a la API real) — ver VITE_API_URL abajo.

# Fase 1, punto 13: número real de WhatsApp de 0km, formato internacional
# sin "+" ni espacios (ej. 56998543632). Sin configurar, el botón de
# WhatsApp se oculta en vez de mostrar un link roto.
VITE_WHATSAPP_NUMBER=56900000000

# Fase D: URL base de la API Laravel real (api/, desplegada en
# https://api.fondos.0km.app). Todavía no se usa en el código — se agrega
# cuando se conecte src/lib/api.js a esta API en vez de Supabase/placeholders.
VITE_API_URL=https://api.fondos.0km.app
