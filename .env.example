# Fase 1, punto 13: número real de WhatsApp de 0km, formato internacional
# sin "+" ni espacios (ej. 56998543632). Sin configurar, el botón de
# WhatsApp se oculta en vez de mostrar un link roto.
VITE_WHATSAPP_NUMBER=56900000000

# Fase D: URL base de la API Laravel real (api/, desplegada en
# https://api.fondos.0km.app). src/lib/api.js consulta esta URL para
# fondos y leads; sin configurar, cae a datos de ejemplo (placeholder)
# y los leads no se guardan en ningún backend (ver DEPLOY_API.md).
VITE_API_URL=https://api.fondos.0km.app
